msgstr "Bannerns introduktionstext"

#: inc/settings.php:59
msgid "Cookie policy page URL"
msgstr "URL till cookiepolicysida"

#: inc/settings.php:67
msgid "Cookie lifetime (days)"
msgstr "Cookiens giltighetstid (dagar)"

