#: inc/settings.php:139
#: inc/settings.php:852
msgid "Reopen banner"
msgstr "Återöppna banner"

#: inc/settings.php:163
msgid "We value your privacy"
msgstr "Vi värnar om din integritet"

#. translators: %s: URL of the cookie policy page.
#: inc/settings.php:168
#, php-format
msgid "We use cookies to improve your experience, show personalised content and analyse our traffic. By clicking \"Accept all\" you consent to our use of cookies. <a href=\"%s\">Read about cookies</a>"
msgstr "Vi använder cookies för att förbättra din upplevelse, visa anpassat innehåll och analysera vår trafik. Genom att klicka på \"Acceptera alla\" samtycker du till vår användning av cookies. <a href=\"%s\">Läs om cookies</a>"

#: inc/settings.php:172
msgid "Required for the website to function properly. These cookies do not store any personal data."
msgstr "Krävs för att webbplatsen ska fungera korrekt. Dessa cookies lagrar inga personuppgifter."

#: inc/settings.php:176
msgid "Help us understand how visitors interact with the website — number of visitors, bounce rate, traffic source, etc."
msgstr "Hjälper oss förstå hur besökare interagerar med webbplatsen — antal besökare, avvisningsfrekvens, trafikkälla m.m."

#: inc/settings.php:180
msgid "Enable enhanced functionality such as saved preferences, language selection or embedded content."
msgstr "Möjliggör förbättrad funktionalitet som sparade inställningar, språkval eller inbäddat innehåll."

#: inc/settings.php:184
msgid "Used for personalised advertising and tracking via third-party services such as Google Ads and Meta."
msgstr "Används för personanpassad annonsering och spårning via tredjepartstjänster som Google Ads och Meta."

#: inc/settings.php:188
msgid "Cookies from embedded services such as YouTube, Vimeo or Google Maps."
msgstr "Cookies från inbäddade tjänster som YouTube, Vimeo eller Google Maps."

#: inc/settings.php:192
#: inc/settings.php:758
msgid "Manage cookies"
msgstr "Hantera cookies"

#: inc/settings.php:368
msgid "The heading displayed at the top of the cookie banner."
msgstr "Rubriken som visas överst i cookiebannern."

#: inc/settings.php:371
#: inc/settings.php:404
#: inc/settings.php:441
#: inc/settings.php:507
msgid "Edit"
msgstr "Redigera"

#. translators: %s is replaced with the cookie policy page URL.
#: inc/settings.php:400
#, php-format
msgid "The intro text in the banner. Use %s as a placeholder where the link to the cookie policy page is inserted."
msgstr "Introduktionstexten i bannern. Använd %s som platshållare där länken till cookiepolicysidan infogas."

#. translators: %s is replaced with the placeholder text in the banner text field.
#: inc/settings.php:437
#, php-format
msgid "Link inserted into the banner text via %s. Leave empty to use the default path /cookies/."
msgstr "Länk som infogas i bannertexten via %s. Lämna tomt för standardsökvägen /cookies/."

#: inc/settings.php:470
msgid "Modal is displayed centred on the page with a dark overlay. Strip is displayed along the bottom of the page without an overlay."
msgstr "Modal visas centrerat på sidan med mörk overlay. Remsa visas längs sidans nederkant utan overlay."

#: inc/settings.php:481
msgid "Modal (centred)"
msgstr "Modal (centrerad)"

#: inc/settings.php:490
msgid "Strip (bottom)"
msgstr "Remsa (nederkant)"

#: inc/settings.php:504
msgid "How long the visitor's consent choice is stored. Default: 365 days (1 year)."
msgstr "Hur länge besökarens samtyckesval sparas. Standard: 365 dagar (1 år)."

#: inc/settings.php:512
msgid "days"
msgstr "dagar"

#: inc/settings.php:531
msgid "Necessary cookies are always shown. Enable the categories your site actually uses — others will not appear in the banner."
msgstr "Nödvändiga visas alltid. Aktivera de kategorier webbplatsen faktiskt använder — övriga visas inte i bannern."

#: inc/settings.php:541
msgid "Always active"
msgstr "Alltid aktiv"

#: inc/settings.php:544
#: inc/settings.php:586
#: inc/settings.php:624
#: inc/settings.php:660
#: inc/settings.php:696
msgid "Edit info"
msgstr "Redigera info"

