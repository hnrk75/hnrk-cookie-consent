msgstr "Cookiesamtycke"

#: inc/settings.php:842
msgid "Banner"
msgstr "Bannern"

#: inc/settings.php:847
msgid "Categories"
msgstr "Kategorier"

#: inc/settings.php:854
msgid "Choose how visitors can reopen the banner after making their choice."
msgstr "Välj hur besökare kan öppna bannern igen efter att ha gjort sitt val."

