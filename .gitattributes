# Files left out of the package Composer downloads (GitHub's zip of a tag).
# They are only needed to develop the plugin, not to run it.
/.gitattributes      export-ignore
/.gitignore          export-ignore
/.github             export-ignore
/.stylelintrc.json   export-ignore
/assets/scss         export-ignore
/composer.lock       export-ignore
/eslint.config.js    export-ignore
/gulpfile.mjs        export-ignore
/package.json        export-ignore
/package-lock.json   export-ignore
/phpcs.xml           export-ignore
